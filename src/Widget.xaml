<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrbitEvolved;assembly=Orbit E(volved)"
        Title="Orbit E(volved) · Agent activity" Width="380" Height="484" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="Segoe UI"
        FontSize="13" Foreground="#F3F3F3" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#EB242424"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C4C4C4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#19FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#88FFFFFF"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#30FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="SlimBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="Transparent" Width="8"><Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb MinHeight="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="3" CornerRadius="1.5" Background="#58FFFFFF" HorizontalAlignment="Center" MinHeight="16"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="PanningMode" Value="VerticalOnly"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="0,0,8,0"/><ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimBar}" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" MinWidth="8" Margin="0,4,1,4" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Visibility="Collapsed" Value="0"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Track" Grid.Column="1" Width="30" Height="17" Background="#30FFFFFF" CornerRadius="9"><Ellipse x:Name="Knob" Fill="#999999" Width="11" Height="11" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#70FFFFFF"/><Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="BranchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="16"/><Setter Property="Height" Value="28"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="#BABABA" StrokeThickness="1.1" Width="4" Height="8" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ExpanderColumn" Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="Row" Grid.Column="1" CornerRadius="8" Background="Transparent"/>
          <ToggleButton x:Name="Expander" Style="{StaticResource BranchToggle}" VerticalAlignment="Top" Margin="0,4,0,0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
          <ContentPresenter Grid.Column="1" x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
          <Border x:Name="ChildrenBorder" Grid.Row="1" Grid.Column="1" BorderBrush="#28FFFFFF" BorderThickness="1,0,0,0" Margin="-8,0,0,0" Padding="7,0,0,0"><ItemsPresenter x:Name="ItemsHost"/></Border>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenBorder" Property="Visibility" Value="Collapsed"/></Trigger><DataTrigger Binding="{Binding Kind}" Value="session"><Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/><Setter TargetName="ExpanderColumn" Property="Width" Value="0"/><Setter TargetName="ChildrenBorder" Property="Margin" Value="0"/><Setter TargetName="ChildrenBorder" Property="Padding" Value="0"/><Setter TargetName="ChildrenBorder" Property="BorderThickness" Value="0"/></DataTrigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#11FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#14FFFFFF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
      <Grid ToolTip="{Binding Hint}">
        <Grid x:Name="AgentHeader" Margin="0,2">
          <Grid Margin="2,6,1,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="Auto" Height="Auto" Padding="0" HorizontalContentAlignment="Stretch" Tag="{Binding Agent}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="Open agent details">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#60FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style>
              </Button.Style>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}" Foreground="#F4F6FB" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="#C0C5CE" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" VerticalAlignment="Top"/>
          </Grid>
        </Grid>
        <Grid x:Name="GroupHeader" Visibility="Collapsed" Margin="4,10,4,4"><TextBlock Text="{Binding Title}" FontSize="11" Foreground="#8E96A3" HorizontalAlignment="Center"/></Grid>
        <Grid x:Name="ProjectHeader" Visibility="Collapsed" Margin="3,7,5,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Foreground="#F4F6FB" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#9BA3B0" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="ChatHeader" Visibility="Collapsed" Margin="-3,1,4,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Style="{StaticResource TextButton}" Tag="{Binding Chat}" AutomationProperties.Name="{Binding AccessibleName}" Height="Auto" HorizontalContentAlignment="Stretch" Padding="5,5">
            <StackPanel>
              <TextBlock Text="{Binding Title}" Foreground="#F4F6FB" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Description}" Foreground="{Binding ChatDescriptionBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
              <TextBlock Text="{Binding ChatUpdate}" Foreground="#C0C5CE" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                  <DataTrigger Binding="{Binding ChatUpdate}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button x:Name="ChatCodex" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource IconButton}" Tag="{Binding Chat}" CommandParameter="codex" Content="↗" ToolTip="Open in Codex" AutomationProperties.Name="{Binding CodexAccessibleName}"/>
        </Grid>
      </Grid>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="session"><Setter TargetName="AgentHeader" Property="Visibility" Value="Collapsed"/><Setter TargetName="GroupHeader" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="project"><Setter TargetName="AgentHeader" Property="Visibility" Value="Collapsed"/><Setter TargetName="ProjectHeader" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="chat"><Setter TargetName="AgentHeader" Property="Visibility" Value="Collapsed"/><Setter TargetName="ChatHeader" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding CanOpenInCodex}" Value="True"><Setter TargetName="ChatCodex" Property="Visibility" Value="Visible"/></DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
    <DataTemplate x:Key="EventTemplate">
      <Border BorderThickness="0,0,0,1" BorderBrush="#18FFFFFF" Padding="0,8,7,8">
        <local:ActivityTextBlock Body="{Binding Body}" Workspace="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" TextWrapping="Wrap" FontSize="12" Foreground="#D0D0D0"/>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="12" x:Name="Root">
    <Border x:Name="Surface" CornerRadius="15" BorderThickness="1">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1"><GradientStop Color="#C8343434" Offset="0"/><GradientStop Color="#D0212121" Offset="0.45"/><GradientStop Color="#D5181818" Offset="1"/></LinearGradientBrush></Border.Background>
      <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#70FFFFFF" Offset="0"/><GradientStop Color="#28FFFFFF" Offset="0.5"/><GradientStop Color="#3AFFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
      <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/></Border.Effect>
      <Grid>
        <Grid x:Name="ExpandedView" Margin="11,0">
          <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
          <Grid x:Name="DragHeader" Background="Transparent" Cursor="SizeAll"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"/>
            <StackPanel VerticalAlignment="Center" Margin="1,0,9,0"><TextBlock x:Name="ProjectLabel" Text="subagent-view" Foreground="#F4F6FB" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SummaryTitle" Text="Waiting for agents" Foreground="#AEB7C5" FontSize="10" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings" AutomationProperties.Name="Widget settings"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="12"/></Button><Button x:Name="CollapseButton" Style="{StaticResource IconButton}" ToolTip="Collapse · Esc" AutomationProperties.Name="Collapse widget"><Path Data="M 0,0 L 9,0" Stroke="#C4C4C4" StrokeThickness="1"/></Button></StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="-3,5,-3,5" x:Name="ContentArea">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="CatalogTools" Orientation="Horizontal" Visibility="Collapsed" Margin="3,0,4,6">
              <Button x:Name="AllChatsButton" Style="{StaticResource TextButton}" Content="All"/>
              <Button x:Name="ActiveChatsButton" Style="{StaticResource TextButton}" Content="Active" Margin="4,0,0,0"/>
            </StackPanel>
            <TreeView Grid.Row="1" x:Name="AgentTreeView" Foreground="#F3F3F3" Background="Transparent" BorderThickness="0" Padding="0,0,4,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Session, agents, and activity tree"/>
            <StackPanel Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" Margin="22,0"><TextBlock x:Name="EmptyHeading" Text="No agents yet" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="EmptyDescription" Text="Activity will appear here as your team starts working." Foreground="#BDBDBD" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/><Button x:Name="PreviewButton" Content="Preview the widget" Style="{StaticResource TextButton}" Background="#15FFFFFF" HorizontalAlignment="Left"/></StackPanel>
          </Grid>
          <Grid Grid.Row="2" x:Name="Footer">
            <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SourceLabel" Text="Local activity" Foreground="#B0B0B0" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="1,0,6,0"/>
              <Button x:Name="ChatFilesButton" Visibility="Collapsed" Grid.Column="1" Content="Files" Style="{StaticResource TextButton}" FontSize="10" Height="25" ToolTip="Files changed in this chat"/>
              <Button x:Name="GraphButton" Grid.Column="2" Content="Graph" Style="{StaticResource TextButton}" FontSize="10" Height="25" Visibility="Collapsed" ToolTip="Open the agent workflow graph" AutomationProperties.Name="Open agent workflow graph"/>
              <Button x:Name="SourceButton" Grid.Column="3" Content="Codex" Style="{StaticResource TextButton}" FontSize="10" Height="25"/>
            </Grid>
          </Grid>
        </Grid>
        <Grid x:Name="DetailView" Visibility="Collapsed" Margin="14,9">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <Button x:Name="BackButton" Content="←  Agent tree" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
          <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="DetailName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" x:Name="DetailStatus" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
          <ScrollViewer Grid.Row="2" x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <local:ActivityTextBlock x:Name="DetailTask" Foreground="#D0D0D0" TextWrapping="Wrap" FontSize="12" Margin="0,0,7,7"/>
              <StackPanel x:Name="DetailHistory" Margin="0,6,0,0">
                <TextBlock Text="Earlier activity" FontSize="11" Foreground="#B3B3B3" Margin="0,0,0,2"/>
                <ItemsControl x:Name="DetailEvents" ItemTemplate="{StaticResource EventTemplate}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="3">
            <Button x:Name="CopyButton" Content="Copy activity" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,0" FontSize="11"/>
            <Button x:Name="ToggleReadsButton" Content="Show file reads" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" FontSize="11" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="14,9">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <Button x:Name="SettingsBackButton" Content="←  Back" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
          <ScrollViewer Grid.Row="1"><StackPanel Margin="0,10,0,0"><TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Source" Foreground="#BDBDBD" FontSize="11"/>
            <Grid Margin="0,8,0,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="LiveButton" Content="Live · Codex" Style="{StaticResource TextButton}" Margin="0,0,3,0"/><Button x:Name="DemoButton" Grid.Column="1" Content="Preview" Style="{StaticResource TextButton}" Margin="3,0,0,0"/></Grid>
            <TextBlock x:Name="SettingsSource" Text="Local session activity." TextWrapping="Wrap" FontSize="11" Foreground="#B8B8B8" Margin="0,0,0,11"/>
            <CheckBox x:Name="TopmostCheck" Content="Always on top" IsChecked="True"/><CheckBox x:Name="MotionCheck" Content="Animations" IsChecked="True"/><CheckBox x:Name="AttentionCheck" Content="Expand when attention is needed" IsChecked="True"/>
            <CheckBox x:Name="StartupCheck" Content="Start on Startup" ToolTip="Open Orbit E(volved) when you sign in to Windows."/>
            <TextBlock x:Name="StartupStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="#B8B8B8" Margin="0,0,0,4"/>
            <StackPanel x:Name="CornerSettings"><Border Height="1" Background="#28FFFFFF" Margin="0,9,0,12"/><TextBlock Text="Corner" Foreground="#BDBDBD" FontSize="11"/>
            <UniformGrid Rows="1" Columns="4" Margin="0,8,0,0"><Button x:Name="TopLeftButton" Content="↖" ToolTip="Top left" AutomationProperties.Name="Top left corner" Style="{StaticResource TextButton}" Margin="0,0,3,0"/><Button x:Name="TopRightButton" Content="↗" ToolTip="Top right" AutomationProperties.Name="Top right corner" Style="{StaticResource TextButton}" Margin="3,0"/><Button x:Name="BottomLeftButton" Content="↙" ToolTip="Bottom left" AutomationProperties.Name="Bottom left corner" Style="{StaticResource TextButton}" Margin="3,0"/><Button x:Name="BottomRightButton" Content="↘" ToolTip="Bottom right" AutomationProperties.Name="Bottom right corner" Style="{StaticResource TextButton}" Margin="3,0,0,0"/></UniformGrid></StackPanel>
          </StackPanel></ScrollViewer>
          <Button Grid.Row="2" x:Name="QuitButton" Content="Quit Orbit E(volved)" Style="{StaticResource TextButton}" FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
        <Grid x:Name="PillView" Visibility="Collapsed" Margin="10,0">
          <Button x:Name="ExpandButton" Background="Transparent" Style="{StaticResource TextButton}" Height="Auto" HorizontalContentAlignment="Stretch" Padding="1,0" AutomationProperties.Name="Expand Orbit E(volved) agent activity"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PillTitle" Text="Agents working" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PillSubtitle" Text="Orbit E(volved)" FontSize="10" Foreground="#B8B8B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="↗" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center"/></Grid></Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
